diff --git a/.github/workflows/product-acceptance.yml b/.github/workflows/product-acceptance.yml
index eafac82..fbdc2da 100644
--- a/.github/workflows/product-acceptance.yml
+++ b/.github/workflows/product-acceptance.yml
@@ -24,6 +24,11 @@ jobs:
       - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
         with:
           python-version: '3.12'
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: '22'
+      - name: Install desktop TypeScript compiler
+        run: npm ci --prefix apps/medusa-desktop --ignore-scripts
       - uses: dtolnay/rust-toolchain@39b0b3842c7e8bbf6904c0bfc3d9006fdd4dc4e0 # 1.88.0
       - name: Refresh dependency lock for the merged PR graph
         run: cargo generate-lockfile
@@ -36,6 +41,8 @@ jobs:
             echo 0 | sudo tee /proc/sys/kernel/apparmor_restrict_unprivileged_userns
           fi
       - name: Run shared-target PR smoke acceptance
+        env:
+          NODE_PATH: ${{ github.workspace }}/apps/medusa-desktop/node_modules
         run: python3 scripts/product-acceptance-smoke.py --output product-acceptance-smoke-artifacts
       - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
         if: always()
@@ -56,6 +63,11 @@ jobs:
     runs-on: ${{ matrix.os }}
     steps:
       - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: '22'
+      - name: Install desktop TypeScript compiler
+        run: npm ci --prefix apps/medusa-desktop --ignore-scripts
       - uses: dtolnay/rust-toolchain@39b0b3842c7e8bbf6904c0bfc3d9006fdd4dc4e0 # 1.88.0
       - name: Refresh dependency lock for the merged commit graph
         run: cargo generate-lockfile
@@ -69,6 +81,8 @@ jobs:
             echo 0 | sudo tee /proc/sys/kernel/apparmor_restrict_unprivileged_userns
           fi
       - name: Run authoritative product acceptance suite
+        env:
+          NODE_PATH: ${{ github.workspace }}/apps/medusa-desktop/node_modules
         run: cargo product-acceptance --output product-acceptance-artifacts
       - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
         if: always()
diff --git a/benchmarks/typescript-semantic-suite.json b/benchmarks/typescript-semantic-suite.json
new file mode 100644
index 0000000..70e5c1e
--- /dev/null
+++ b/benchmarks/typescript-semantic-suite.json
@@ -0,0 +1,16 @@
+{
+  "schema_version": 1,
+  "adapter": "typescript-compiler-language-service",
+  "limits": {
+    "max_supported_sources": 20000,
+    "max_results_per_request": 2000
+  },
+  "scenarios": [
+    {"id":"cross-file-definition","operation":"definition","correctness":"target path and range resolve across modules","budget_ms":2000},
+    {"id":"cross-file-references","operation":"references","correctness":"declaration and call sites are returned without ignored paths","budget_ms":2500},
+    {"id":"strict-diagnostics","operation":"diagnostics","correctness":"syntactic and semantic type errors are stable","budget_ms":3000},
+    {"id":"workspace-symbols","operation":"workspace_symbols","correctness":"monorepo-selected project symbols are deterministic","budget_ms":3000},
+    {"id":"guarded-rename","operation":"rename","correctness":"all semantic locations carry source hashes and byte preconditions","budget_ms":3000},
+    {"id":"repository-switch","operation":"definition","correctness":"content-derived workspace fingerprints differ after switching repositories","budget_ms":2000}
+  ]
+}
