+pub(crate) fn typescript_semantic(repo: &Path, input: &Value) -> MedusaResult<String> {
+    let operation = serde_json::from_value::<TypeScriptSemanticOperation>(
+        input
+            .get("operation")
+            .cloned()
+            .ok_or_else(|| crate::tools::invalid_tool("operation is required"))?,
+    )
+    .map_err(|error| crate::tools::invalid_tool(error.to_string()))?;
+    let target = input
+        .get("path")
+        .and_then(Value::as_str)
+        .map(Path::new);
+    if let Some(path) = target {
+        let _ = safe_path(repo, path.to_string_lossy().as_ref())?;
+    }
+    let line = input
+        .get("line")
+        .and_then(Value::as_u64)
+        .map(|value| value as u32);
+    let character = input
+        .get("character")
+        .and_then(Value::as_u64)
+        .map(|value| value as u32);
+    let query = input.get("query").and_then(Value::as_str);
+    let result = run_typescript_semantic(repo, operation, target, line, character, query)
+        .map_err(|error| crate::tools::invalid_tool(error.to_string()))?;
+    Ok(serde_json::to_string_pretty(&result)?)
+}
