+    #[test]
+    fn labelled_fixture_measures_precision_recall_and_false_positive_rate() {
+        let temp = TempDir::new().unwrap();
+        let store = ScopedMemoryStore::new(temp.path().join("user.json"), None);
+        let fixtures = [
+            ("ci", "validation.ci", "Use GitHub CI for validation"),
+            ("slides", "artifact.slides", "Use visual hierarchy in slide decks"),
+            ("memo", "artifact.memo", "Use an answer-first structure in memos"),
+        ];
+        for (index, (id, key, rule)) in fixtures.iter().enumerate() {
+            store
+                .upsert(
+                    learning(id, key, LearningScope::User, rule, 10),
+                    u64::try_from(index).unwrap(),
+                )
+                .unwrap();
+        }
+        let cases = [
+            ("Validate this repository with GitHub CI", Some("ci")),
+            ("Create a slide deck with strong visual hierarchy", Some("slides")),
+            ("Draft an answer-first legal memo", Some("memo")),
+            ("Explain a Rust lifetime", None),
+        ];
+        let mut true_positive = 0_u32;
+        let mut false_positive = 0_u32;
+        let mut false_negative = 0_u32;
+        for (objective, expected) in cases {
+            let result = store
+                .retrieve(&query(context(None), objective, 20))
+                .unwrap();
+            let actual = result.selected.first().map(|item| item.learning.id.as_str());
+            match (expected, actual) {
+                (Some(expected), Some(actual)) if expected == actual => true_positive += 1,
+                (Some(_), None) => false_negative += 1,
+                (None, Some(_)) | (Some(_), Some(_)) => false_positive += 1,
+                (None, None) => {}
+            }
+        }
+        let precision = f64::from(true_positive)
+            / f64::from((true_positive + false_positive).max(1));
+        let recall = f64::from(true_positive)
+            / f64::from((true_positive + false_negative).max(1));
+        let false_positive_rate = f64::from(false_positive) / 4.0;
+        assert!(precision >= 0.99, "precision={precision}");
+        assert!(recall >= 0.99, "recall={recall}");
+        assert!(false_positive_rate <= 0.01, "fpr={false_positive_rate}");
+    }
+
+    #[test]
+    fn retrieval_is_bounded_for_a_large_corpus() {
+        let temp = TempDir::new().unwrap();
+        let store = ScopedMemoryStore::new(temp.path().join("user.json"), None);
+        for index in 0..500_u64 {
+            store
+                .upsert(
+                    learning(
+                        &format!("item-{index}"),
+                        &format!("topic.{index}"),
+                        LearningScope::User,
+                        &format!("Apply specialized behavior number {index}"),
+                        10,
+                    ),
+                    index,
+                )
+                .unwrap();
+        }
+        let started = Instant::now();
+        let result = store
+            .retrieve(&RetrievalQuery {
+                max_results: 5,
+                ..query(context(None), "Apply specialized behavior number 499", 20)
+            })
+            .unwrap();
+        assert!(result.selected.len() <= 5);
+        assert!(started.elapsed() < Duration::from_secs(2));
+    }
