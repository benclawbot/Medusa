diff --git a/crates/medusa-agent/src/learning_retrieval.rs b/crates/medusa-agent/src/learning_retrieval.rs
new file mode 100644
index 0000000..a0cd81f
--- /dev/null
+++ b/crates/medusa-agent/src/learning_retrieval.rs
@@ -0,0 +1,423 @@
+use std::{
+    collections::BTreeSet,
+    env, fs,
+    fs::OpenOptions,
+    io::Write,
+    path::{Path, PathBuf},
+};
+
+use medusa_config::Mode;
+use medusa_core::{ErrorCategory, ErrorCode, MedusaError, MedusaResult};
+use medusa_improvement::{
+    retrieval::{RetrievalQuery, RetrievalResult},
+    scoped_memory::{RepositoryIdentity, ScopeContext, ScopedMemoryStore},
+};
+use medusa_provider::{MessageBlock, Role};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use time::OffsetDateTime;
+
+use crate::session::AgentSession;
+
+const MAX_SELECTED_LEARNINGS: usize = 8;
+
+pub(crate) struct AgentLearningRetrieval {
+    pub system_fragment: Option<String>,
+    pub status: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct SelectionAudit<'a> {
+    session_id: &'a str,
+    turn: u32,
+    objective_digest: String,
+    decisions: &'a [medusa_improvement::retrieval::RetrievalDecision],
+    recorded_at_unix_ms: i64,
+}
+
+pub(crate) fn retrieve_for_session(
+    session: &AgentSession,
+    mode: Mode,
+) -> MedusaResult<Option<AgentLearningRetrieval>> {
+    let Some(user_store) = user_store_path() else {
+        return Ok(None);
+    };
+    let repository_store = session.repo.join(".medusa/learnings.json");
+    if !user_store.is_file() && !repository_store.is_file() {
+        return Ok(None);
+    }
+
+    let store = ScopedMemoryStore::new(user_store, Some(repository_store));
+    let now_unix_ms = OffsetDateTime::now_utc().unix_timestamp().saturating_mul(1_000);
+    retrieve_from_store(session, mode, &store, owner_id(), now_unix_ms)
+}
+
+fn retrieve_from_store(
+    session: &AgentSession,
+    mode: Mode,
+    store: &ScopedMemoryStore,
+    owner_id: String,
+    now_unix_ms: i64,
+) -> MedusaResult<Option<AgentLearningRetrieval>> {
+    let context = ScopeContext {
+        owner_id,
+        repository: repository_identity(&session.repo),
+        workspace_id: env::var("MEDUSA_WORKSPACE_ID").ok(),
+        organization_id: env::var("MEDUSA_ORGANIZATION_ID").ok(),
+        session_id: Some(session.id.to_string()),
+        task_id: Some(format!("{}-turn-{}", session.id, session.turn.saturating_add(1))),
+        task_kind: Some(infer_task_kind(&session.objective)),
+        artifact_kind: Some(infer_artifact_kind(&session.objective)),
+        context_tags: context_tags(&session.objective, mode),
+    };
+    let base_query = RetrievalQuery {
+        context,
+        objective: session.objective.clone(),
+        phase: None,
+        now_unix_ms,
+        max_results: MAX_SELECTED_LEARNINGS,
+        suppressed_learning_ids: BTreeSet::new(),
+        approved_high_impact_ids: BTreeSet::new(),
+    };
+    let initial = store.retrieve(&base_query).map_err(retrieval_error)?;
+    let latest_user_text = latest_user_text(session);
+    let (suppressed, approved) = explicit_overrides(&initial, &latest_user_text);
+    let result = if suppressed.is_empty() && approved.is_empty() {
+        initial
+    } else {
+        store
+            .retrieve(&RetrievalQuery {
+                suppressed_learning_ids: suppressed,
+                approved_high_impact_ids: approved,
+                ..base_query
+            })
+            .map_err(retrieval_error)?
+    };
+    let mut status = result.status_summary();
+    if mode != Mode::ReadOnly
+        && let Err(error) = persist_audit(session, &result, now_unix_ms)
+    {
+        status.push_str(&format!("\nSelection audit could not be persisted: {error}"));
+    }
+    Ok(Some(AgentLearningRetrieval {
+        system_fragment: result.system_fragment(),
+        status,
+    }))
+}
+
+fn user_store_path() -> Option<PathBuf> {
+    if let Some(root) = env::var_os("MEDUSA_HOME").map(PathBuf::from) {
+        return Some(preferred_learning_path(&root));
+    }
+    env::var_os("HOME")
+        .or_else(|| env::var_os("USERPROFILE"))
+        .map(PathBuf::from)
+        .map(|home| preferred_learning_path(&home.join(".medusa")))
+}
+
+fn preferred_learning_path(root: &Path) -> PathBuf {
+    let legacy = root.join("learnings.json");
+    if legacy.is_file() {
+        legacy
+    } else {
+        root.join("learning/learnings.json")
+    }
+}
+
+fn owner_id() -> String {
+    env::var("MEDUSA_OWNER_ID")
+        .or_else(|_| env::var("USER"))
+        .or_else(|_| env::var("USERNAME"))
+        .unwrap_or_else(|_| "default".to_owned())
+}
+
+fn repository_identity(repo: &Path) -> Option<RepositoryIdentity> {
+    let canonical = fs::canonicalize(repo).unwrap_or_else(|_| repo.to_path_buf());
+    let origin = git_origin(repo).unwrap_or_else(|| canonical.to_string_lossy().into_owned());
+    let common = git_common_directory(repo).unwrap_or(canonical);
+    RepositoryIdentity::new(&origin, &common.to_string_lossy()).ok()
+}
+
+fn git_origin(repo: &Path) -> Option<String> {
+    let config = git_directory(repo)?.join("config");
+    let content = fs::read_to_string(config).ok()?;
+    let mut in_origin = false;
+    for line in content.lines() {
+        let trimmed = line.trim();
+        if trimmed.starts_with('[') {
+            in_origin = trimmed == "[remote \"origin\"]";
+            continue;
+        }
+        if in_origin
+            && let Some(value) = trimmed.strip_prefix("url =")
+        {
+            return Some(value.trim().to_owned());
+        }
+    }
+    None
+}
+
+fn git_common_directory(repo: &Path) -> Option<PathBuf> {
+    let git = git_directory(repo)?;
+    let common = git.join("commondir");
+    if let Ok(value) = fs::read_to_string(common) {
+        let value = value.trim();
+        if !value.is_empty() {
+            let path = PathBuf::from(value);
+            return Some(if path.is_absolute() { path } else { git.join(path) });
+        }
+    }
+    Some(git)
+}
+
+fn git_directory(repo: &Path) -> Option<PathBuf> {
+    let dot_git = repo.join(".git");
+    if dot_git.is_dir() {
+        return Some(dot_git);
+    }
+    let content = fs::read_to_string(dot_git).ok()?;
+    let target = content.trim().strip_prefix("gitdir:")?.trim();
+    let path = PathBuf::from(target);
+    Some(if path.is_absolute() { path } else { repo.join(path) })
+}
+
+fn infer_task_kind(objective: &str) -> String {
+    let lower = objective.to_ascii_lowercase();
+    if contains_any(&lower, &["research", "investigate", "compare sources"]) {
+        "research"
+    } else if contains_any(&lower, &["write", "document", "memo", "report"]) {
+        "writing"
+    } else if contains_any(&lower, &["review", "audit", "inspect"]) {
+        "review"
+    } else {
+        "coding"
+    }
+    .to_owned()
+}
+
+fn infer_artifact_kind(objective: &str) -> String {
+    let lower = objective.to_ascii_lowercase();
+    if contains_any(&lower, &["presentation", "slides", "deck"]) {
+        "presentation"
+    } else if contains_any(&lower, &["spreadsheet", "workbook", "sheet"]) {
+        "spreadsheet"
+    } else if contains_any(&lower, &["document", "memo", "report"]) {
+        "document"
+    } else {
+        "repository"
+    }
+    .to_owned()
+}
+
+fn context_tags(objective: &str, mode: Mode) -> BTreeSet<String> {
+    let mut tags = objective
+        .split(|character: char| {
+            !character.is_alphanumeric() && character != '-' && character != '_'
+        })
+        .filter(|value| value.len() > 2)
+        .map(|value| value.to_ascii_lowercase())
+        .collect::<BTreeSet<_>>();
+    tags.insert(if mode == Mode::ReadOnly {
+        "read_only".to_owned()
+    } else {
+        "execution".to_owned()
+    });
+    tags
+}
+
+fn latest_user_text(session: &AgentSession) -> String {
+    session
+        .messages
+        .iter()
+        .rev()
+        .find(|message| message.role == Role::User)
+        .map(|message| {
+            message
+                .content
+                .iter()
+                .filter_map(|block| match block {
+                    MessageBlock::Text { text } => Some(text.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        })
+        .unwrap_or_default()
+        .to_ascii_lowercase()
+}
+
+fn explicit_overrides(
+    result: &RetrievalResult,
+    user_text: &str,
+) -> (BTreeSet<String>, BTreeSet<String>) {
+    let mut suppressed = BTreeSet::new();
+    let mut approved = BTreeSet::new();
+    for decision in &result.decisions {
+        let id = decision.learning_id.to_ascii_lowercase();
+        if [
+            format!("suppress learning {id}"),
+            format!("disable learning {id}"),
+            format!("do not apply learning {id}"),
+        ]
+        .iter()
+        .any(|phrase| user_text.contains(phrase))
+        {
+            suppressed.insert(decision.learning_id.clone());
+        }
+        if [
+            format!("approve learning {id}"),
+            format!("apply learning {id}"),
+        ]
+        .iter()
+        .any(|phrase| user_text.contains(phrase))
+        {
+            approved.insert(decision.learning_id.clone());
+        }
+    }
+    (suppressed, approved)
+}
+
+fn persist_audit(
+    session: &AgentSession,
+    result: &RetrievalResult,
+    now_unix_ms: i64,
+) -> MedusaResult<()> {
+    let path = session
+        .repo
+        .join(".medusa/learning/selection-audit")
+        .join(format!("{}.jsonl", session.id));
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let audit = SelectionAudit {
+        session_id: session.id.as_str(),
+        turn: session.turn.saturating_add(1),
+        objective_digest: hex::encode(Sha256::digest(session.objective.as_bytes())),
+        decisions: &result.decisions,
+        recorded_at_unix_ms: now_unix_ms,
+    };
+    let line = serde_json::to_string(&audit)?;
+    let mut file = OpenOptions::new().create(true).append(true).open(path)?;
+    writeln!(file, "{line}")?;
+    Ok(())
+}
+
+fn retrieval_error(error: medusa_improvement::scoped_memory::StoreError) -> MedusaError {
+    MedusaError::new(
+        ErrorCode::PersistenceFailed,
+        ErrorCategory::Persistence,
+        format!("learned behavior retrieval failed: {error}"),
+    )
+}
+
+fn contains_any(value: &str, needles: &[&str]) -> bool {
+    needles.iter().any(|needle| value.contains(needle))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use medusa_core::SessionId;
+    use medusa_improvement::scoped_memory::{
+        Applicability, LearningProvenance, LearningScope, LearningState, ScopedLearning,
+    };
+    use medusa_provider::{Message, MessageBlock};
+    use tempfile::TempDir;
+
+    fn session(repo: &Path, text: &str) -> AgentSession {
+        AgentSession {
+            id: SessionId::new(),
+            objective: "Validate the repository using GitHub CI".to_owned(),
+            repo: repo.to_path_buf(),
+            created_at: OffsetDateTime::now_utc(),
+            updated_at: OffsetDateTime::now_utc(),
+            completed: false,
+            turn: 0,
+            plan: Vec::new(),
+            pending_question: None,
+            messages: vec![Message {
+                role: Role::User,
+                content: vec![MessageBlock::Text {
+                    text: text.to_owned(),
+                }],
+            }],
+            events: Vec::new(),
+            evidence: Vec::new(),
+            tool_artifacts: Vec::new(),
+            world_model: None,
+            approval_grants: Vec::new(),
+            approval_receipts: Vec::new(),
+            rollback_receipts: Vec::new(),
+        }
+    }
+
+    fn learning(owner: &str) -> ScopedLearning {
+        ScopedLearning {
+            id: "github-ci".to_owned(),
+            conflict_key: "validation.default".to_owned(),
+            owner_id: owner.to_owned(),
+            scope: LearningScope::User,
+            version: 1,
+            state: LearningState::Active,
+            generalized_rule: "Use GitHub CI as the authoritative validator".to_owned(),
+            provenance: LearningProvenance {
+                source_signal_ids: vec!["signal".to_owned()],
+                evidence_digests: vec!["0".repeat(64)],
+                generalized_from_private_content: false,
+            },
+            applicability: Applicability::default(),
+            created_at_unix_ms: 1,
+            updated_at_unix_ms: 1,
+        }
+    }
+
+    #[test]
+    fn shared_agent_retrieval_emits_explanation_and_audit() {
+        let temp = TempDir::new().unwrap();
+        let home = temp.path().join("home");
+        let repo = temp.path().join("repo");
+        fs::create_dir_all(&repo).unwrap();
+        let owner = "retrieval-test-user";
+        let store = ScopedMemoryStore::new(home.join("learning/learnings.json"), None);
+        store.upsert(learning(owner), 0).unwrap();
+        let session = session(&repo, "Validate this with GitHub CI");
+        let retrieval = retrieve_from_store(
+            &session,
+            Mode::Yolo,
+            &store,
+            owner.to_owned(),
+            10,
+        )
+        .unwrap()
+        .expect("retrieval");
+        assert!(retrieval.status.contains("Applied github-ci"));
+        assert!(retrieval
+            .system_fragment
+            .as_deref()
+            .is_some_and(|fragment| fragment.contains("authoritative validator")));
+        assert!(repo
+            .join(".medusa/learning/selection-audit")
+            .join(format!("{}.jsonl", session.id))
+            .is_file());
+    }
+
+    #[test]
+    fn user_can_suppress_selected_learning_for_current_task() {
+        let initial = RetrievalResult {
+            selected: Vec::new(),
+            decisions: vec![medusa_improvement::retrieval::RetrievalDecision {
+                learning_id: "github-ci".to_owned(),
+                conflict_key: "validation.default".to_owned(),
+                kind: medusa_improvement::retrieval::RetrievalDecisionKind::Selected,
+                score: Some(1),
+                reason: "matched".to_owned(),
+            }],
+            conflicts: Vec::new(),
+        };
+        let (suppressed, approved) =
+            explicit_overrides(&initial, "do not apply learning github-ci");
+        assert!(suppressed.contains("github-ci"));
+        assert!(approved.is_empty());
+    }
+}
