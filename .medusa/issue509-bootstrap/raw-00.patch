+    #[test]
+    fn repository_specific_behavior_overrides_user_behavior() {
+        let temp = TempDir::new().unwrap();
+        let store = ScopedMemoryStore::new(
+            temp.path().join("user.json"),
+            Some(temp.path().join("repo.json")),
+        );
+        store
+            .upsert(
+                learning(
+                    "user-ci",
+                    "validation.default",
+                    LearningScope::User,
+                    "Use GitHub CI for validation",
+                    10,
+                ),
+                0,
+            )
+            .unwrap();
+        let mut specific = learning(
+            "repo-ci",
+            "validation.default",
+            LearningScope::Repository,
+            "Use the repository release-gates workflow in GitHub CI",
+            10,
+        );
+        specific.applicability.repository = Some(repository());
+        specific.applicability.task_kinds.insert("coding".to_owned());
+        store.upsert(specific, 0).unwrap();
+
+        let result = store
+            .retrieve(&query(
+                context(Some(repository())),
+                "Validate this change with GitHub CI",
+                20,
+            ))
+            .unwrap();
+        assert_eq!(result.selected.len(), 1);
+        assert_eq!(result.selected[0].learning.id, "repo-ci");
+        assert!(result.decisions.iter().any(|decision| {
+            decision.learning_id == "user-ci" && decision.kind == RetrievalDecisionKind::Shadowed
+        }));
+    }
+
