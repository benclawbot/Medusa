new file mode 100644
index 0000000..77f3c86
--- /dev/null
+++ b/crates/medusa-improvement/src/retrieval.rs
@@ -0,0 +1,798 @@
+//! Explainable, deterministic retrieval of approved scoped learnings.
+//!
+//! Retrieval deliberately builds on the authoritative scope resolver. It does not create a second
+//! persistence model: active entries, scope precedence, repository identity, and conflict history
+//! remain owned by [`ScopedMemoryStore`]. This layer adds relevance ranking, stale-item suppression,
+//! per-task overrides, high-impact approval gates, and concise explanations.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde::{Deserialize, Serialize};
+
+use crate::scoped_memory::{
+    LearningScope, ResolvedLearning, ScopeConflict, ScopeContext, ScopedLearning,
+    ScopedMemoryStore, StoreError,
+};
+
+const STALE_AFTER_MS: i64 = 180 * 24 * 60 * 60 * 1_000;
+const MAX_CONSIDERED: usize = 4_096;
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, Ord, PartialEq, PartialOrd, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ApplicationPhase {
+    Planning,
+    ToolSelection,
+    Execution,
+    Verification,
+    Completion,
+    ResponseStyle,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RetrievalQuery {
+    pub context: ScopeContext,
+    pub objective: String,
+    pub phase: Option<ApplicationPhase>,
+    pub now_unix_ms: i64,
+    pub max_results: usize,
+    pub suppressed_learning_ids: BTreeSet<String>,
+    pub approved_high_impact_ids: BTreeSet<String>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum RetrievalDecisionKind {
+    Selected,
+    Rejected,
+    Suppressed,
+    Shadowed,
+    Conflict,
+    RequiresApproval,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct RetrievalDecision {
+    pub learning_id: String,
+    pub conflict_key: String,
+    pub kind: RetrievalDecisionKind,
+    pub score: Option<i64>,
+    pub reason: String,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SelectedLearning {
+    pub learning: ScopedLearning,
+    pub phase: ApplicationPhase,
+    pub score: i64,
+    pub explanation: String,
+}
+
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct RetrievalResult {
+    pub selected: Vec<SelectedLearning>,
+    pub decisions: Vec<RetrievalDecision>,
+    pub conflicts: Vec<ScopeConflict>,
+}
+
+impl RetrievalResult {
+    #[must_use]
+    pub fn system_fragment(&self) -> Option<String> {
+        if self.selected.is_empty() {
+            return None;
+        }
+        let mut output = String::from(
+            "Approved learned behavior selected for this task. Apply it only at the listed phase, preserve the user's current intent, and prefer repository-specific behavior over broader behavior:\n",
+        );
+        for selected in &self.selected {
+            output.push_str(&format!(
+                "- [{}] phase={}; {}\n  Rule: {}\n",
+                selected.learning.id,
+                phase_name(selected.phase),
+                selected.explanation,
+                selected.learning.generalized_rule.trim()
+            ));
+        }
+        Some(output)
+    }
+
+    #[must_use]
+    pub fn status_summary(&self) -> String {
+        let rejected = self
+            .decisions
+            .iter()
+            .filter(|decision| decision.kind == RetrievalDecisionKind::Rejected)
+            .count();
+        let blocked = self
+            .decisions
+            .iter()
+            .filter(|decision| {
+                matches!(
+                    decision.kind,
+                    RetrievalDecisionKind::Suppressed
+                        | RetrievalDecisionKind::RequiresApproval
+                        | RetrievalDecisionKind::Conflict
+                )
+            })
+            .count();
+        let mut lines = vec![format!(
+            "Learning retrieval: {} selected, {rejected} rejected, {blocked} suppressed or blocked.",
+            self.selected.len()
+        )];
+        for selected in &self.selected {
+            lines.push(format!(
+                "Applied {} at {}: {}",
+                selected.learning.id,
+                phase_name(selected.phase),
+                selected.explanation
+            ));
+        }
+        for decision in self.decisions.iter().filter(|decision| {
+            matches!(
+                decision.kind,
+                RetrievalDecisionKind::Conflict | RetrievalDecisionKind::RequiresApproval
+            )
+        }) {
+            lines.push(format!("Blocked {}: {}", decision.learning_id, decision.reason));
+        }
+        lines.join("\n")
+    }
+}
+
+#[derive(Clone, Debug)]
+struct RankedCandidate {
+    learning: ScopedLearning,
+    phase: ApplicationPhase,
+    score: i64,
+    explanation: String,
+}
+
+impl ScopedMemoryStore {
+    pub fn retrieve(&self, query: &RetrievalQuery) -> Result<RetrievalResult, StoreError> {
+        if query.objective.trim().is_empty() {
+            return Err(StoreError::Validation("retrieval objective cannot be empty"));
+        }
+        if query.max_results == 0 {
+            return Ok(RetrievalResult::default());
+        }
+
+        let resolution = self.resolve(&query.context)?;
+        let objective = normalize(&query.objective);
+        let objective_tokens = keyword_tokens(&objective);
+        let mut result = RetrievalResult {
+            conflicts: resolution.conflicts.clone(),
+            ..RetrievalResult::default()
+        };
+        let mut ranked = Vec::new();
+
+        for resolved in resolution.resolved.into_iter().take(MAX_CONSIDERED) {
+            record_shadowed(&resolved, &mut result);
+            let learning = resolved.winner;
+            let decision = |kind, score, reason: String| RetrievalDecision {
+                learning_id: learning.id.clone(),
+                conflict_key: learning.conflict_key.clone(),
+                kind,
+                score,
+                reason,
+            };
+
+            if query.suppressed_learning_ids.contains(&learning.id) {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Suppressed,
+                    None,
+                    "disabled for the current task by the user".to_owned(),
+                ));
+                continue;
+            }
+            if is_stale(&learning, query.now_unix_ms) {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Rejected,
+                    None,
+                    "learning is stale and requires revalidation".to_owned(),
+                ));
+                continue;
+            }
+            if explicit_negative_match(&learning, &objective, &query.context.context_tags) {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Rejected,
+                    None,
+                    "an explicit exclusion or negative task instruction matched".to_owned(),
+                ));
+                continue;
+            }
+
+            let phase = infer_phase(&learning);
+            if query.phase.is_some_and(|requested| requested != phase) {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Rejected,
+                    None,
+                    format!("learning applies during {}, not this phase", phase_name(phase)),
+                ));
+                continue;
+            }
+
+            let learning_tokens = keyword_tokens(&format!(
+                "{} {}",
+                learning.conflict_key, learning.generalized_rule
+            ));
+            let overlap = objective_tokens.intersection(&learning_tokens).count();
+            let structural = structural_match(&learning, &query.context);
+            if overlap == 0 && !structural {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Rejected,
+                    None,
+                    "no deterministic relevance signal matched".to_owned(),
+                ));
+                continue;
+            }
+
+            if unresolved_equal_precedence_conflict(&resolved) {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::Conflict,
+                    None,
+                    "equally specific active learnings conflict; explicit resolution is required"
+                        .to_owned(),
+                ));
+                continue;
+            }
+            if is_high_impact(&learning)
+                && !query.approved_high_impact_ids.contains(&learning.id)
+            {
+                result.decisions.push(decision(
+                    RetrievalDecisionKind::RequiresApproval,
+                    None,
+                    "high-impact learned behavior requires approval for the current task"
+                        .to_owned(),
+                ));
+                continue;
+            }
+
+            let score = rank_score(&learning, overlap, structural, query.now_unix_ms);
+            let explanation = explain(&learning, overlap, structural);
+            ranked.push(RankedCandidate {
+                learning,
+                phase,
+                score,
+                explanation,
+            });
+        }
+
+        ranked.sort_by(|left, right| {
+            right
+                .score
+                .cmp(&left.score)
+                .then_with(|| right.learning.scope.precedence().cmp(&left.learning.scope.precedence()))
+                .then_with(|| right.learning.version.cmp(&left.learning.version))
+                .then_with(|| left.learning.id.cmp(&right.learning.id))
+        });
+        for candidate in ranked.into_iter().take(query.max_results) {
+            result.decisions.push(RetrievalDecision {
+                learning_id: candidate.learning.id.clone(),
+                conflict_key: candidate.learning.conflict_key.clone(),
+                kind: RetrievalDecisionKind::Selected,
+                score: Some(candidate.score),
+                reason: candidate.explanation.clone(),
+            });
+            result.selected.push(SelectedLearning {
+                learning: candidate.learning,
+                phase: candidate.phase,
+                score: candidate.score,
+                explanation: candidate.explanation,
+            });
+        }
+        Ok(result)
+    }
+}
+
+fn record_shadowed(resolved: &ResolvedLearning, result: &mut RetrievalResult) {
+    for shadowed in &resolved.shadowed {
+        result.decisions.push(RetrievalDecision {
+            learning_id: shadowed.id.clone(),
+            conflict_key: shadowed.conflict_key.clone(),
+            kind: RetrievalDecisionKind::Shadowed,
+            score: None,
+            reason: format!(
+                "shadowed by {} at the more specific {} scope",
+                resolved.winner.id,
+                scope_name(resolved.winner.scope)
+            ),
+        });
+    }
+}
+
+fn unresolved_equal_precedence_conflict(resolved: &ResolvedLearning) -> bool {
+    resolved
+        .shadowed
+        .iter()
+        .any(|item| item.scope == resolved.winner.scope && item.version == resolved.winner.version)
+}
+
+fn is_stale(learning: &ScopedLearning, now_unix_ms: i64) -> bool {
+    now_unix_ms.saturating_sub(learning.updated_at_unix_ms) > STALE_AFTER_MS
+}
+
+fn explicit_negative_match(
+    learning: &ScopedLearning,
+    objective: &str,
+    context_tags: &BTreeSet<String>,
+) -> bool {
+    learning
+        .applicability
+        .excluded_contexts
+        .iter()
+        .any(|excluded| {
+            let excluded = normalize(excluded);
+            objective.contains(&excluded) || context_tags.contains(&excluded)
+        })
+        || learning
+            .retrieval
+            .negative_triggers
+            .iter()
+            .any(|trigger| objective.contains(&normalize(trigger)))
+}
+
+fn structural_match(learning: &ScopedLearning, context: &ScopeContext) -> bool {
+    let task_match = learning.applicability.task_kinds.is_empty()
+        || context
+            .task_kind
+            .as_ref()
+            .is_some_and(|kind| learning.applicability.task_kinds.contains(kind));
+    let artifact_match = learning.applicability.artifact_kinds.is_empty()
+        || context
+            .artifact_kind
+            .as_ref()
+            .is_some_and(|kind| learning.applicability.artifact_kinds.contains(kind));
+    let tags_match = learning.applicability.context_tags.is_empty()
+        || !learning
+            .applicability
+            .context_tags
+            .is_disjoint(&context.context_tags);
+    task_match && artifact_match && tags_match
+}
+
+fn is_high_impact(learning: &ScopedLearning) -> bool {
+    learning.retrieval.high_impact
+        || learning.conflict_key.starts_with("policy.")
+        || learning.conflict_key.starts_with("execution.")
+        || learning.conflict_key.starts_with("deployment.")
+}
+
+fn infer_phase(learning: &ScopedLearning) -> ApplicationPhase {
+    learning
+        .retrieval
+        .phases
+        .iter()
+        .next()
+        .copied()
+        .unwrap_or_else(|| {
+            let key = learning.conflict_key.as_str();
+            if key.starts_with("planning.") {
+                ApplicationPhase::Planning
+            } else if key.starts_with("tool.") {
+                ApplicationPhase::ToolSelection
+            } else if key.starts_with("verification.") || key.starts_with("testing.") {
+                ApplicationPhase::Verification
+            } else if key.starts_with("completion.") {
+                ApplicationPhase::Completion
+            } else if key.starts_with("response.") || key.starts_with("style.") {
+                ApplicationPhase::ResponseStyle
+            } else {
+                ApplicationPhase::Execution
+            }
+        })
+}
+
+fn rank_score(
+    learning: &ScopedLearning,
+    overlap: usize,
+    structural: bool,
+    now_unix_ms: i64,
+) -> i64 {
+    let scope = i64::from(learning.scope.precedence()) * 10_000;
+    let keyword = i64::try_from(overlap).unwrap_or(i64::MAX / 1_000) * 1_000;
+    let structural = if structural { 750 } else { 0 };
+    let confidence = i64::from(learning.retrieval.confidence_milli.min(1_000));
+    let validation = i64::from(learning.retrieval.validation_quality_milli.min(1_000));
+    let recency = (STALE_AFTER_MS
+        .saturating_sub(now_unix_ms.saturating_sub(learning.updated_at_unix_ms))
+        / (24 * 60 * 60 * 1_000))
+        .max(0);
+    scope + keyword + structural + confidence + validation + recency
+}
+
+fn explain(learning: &ScopedLearning, overlap: usize, structural: bool) -> String {
+    let mut reasons = vec![format!(
+        "{} scope matched with precedence {}",
+        scope_name(learning.scope),
+        learning.scope.precedence()
+    )];
+    if overlap > 0 {
+        reasons.push(format!("{overlap} objective keyword(s) matched"));
+    }
+    if structural {
+        reasons.push("task, artifact, or context constraints matched".to_owned());
+    }
+    reasons.push(format!(
+        "confidence {}%, validation {}%",
+        learning.retrieval.confidence_milli / 10,
+        learning.retrieval.validation_quality_milli / 10
+    ));
+    reasons.join("; ")
+}
+
+fn normalize(value: &str) -> String {
+    value
+        .to_ascii_lowercase()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn keyword_tokens(value: &str) -> BTreeSet<String> {
+    const STOP_WORDS: &[&str] = &[
+        "the", "and", "for", "with", "that", "this", "from", "into", "when", "where", "use",
+        "using", "should", "must", "only", "current", "task", "behavior", "learned",
+    ];
+    normalize(value)
+        .split(|character: char| !character.is_alphanumeric() && character != '-' && character != '_')
+        .filter(|token| token.len() > 2 && !STOP_WORDS.contains(token))
+        .map(ToOwned::to_owned)
+        .collect()
+}
+
+fn phase_name(phase: ApplicationPhase) -> &'static str {
+    match phase {
+        ApplicationPhase::Planning => "planning",
+        ApplicationPhase::ToolSelection => "tool selection",
+        ApplicationPhase::Execution => "execution",
+        ApplicationPhase::Verification => "verification",
+        ApplicationPhase::Completion => "completion",
+        ApplicationPhase::ResponseStyle => "response style",
+    }
+}
+
+fn scope_name(scope: LearningScope) -> &'static str {
+    match scope {
+        LearningScope::Global => "global",
+        LearningScope::User => "user",
+        LearningScope::Organization => "organization",
+        LearningScope::Workspace => "workspace",
+        LearningScope::Repository => "repository",
+        LearningScope::Session => "session",
+        LearningScope::Task => "task",
+    }
+}
