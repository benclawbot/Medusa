  "allowed_scope": ["crates/**", "tooling/**", "Cargo.toml", "Cargo.lock"],
  "coverage": ["interruption-resume", "rollback"],
  "execution": {
    "mode": "offline",
    "timeout_seconds": 5400,
    "provider": {"kind": "recording-replay", "fixture": "interrupt-and-resume-v1"}
  },
  "acceptance": {
    "expected_outcome": "verified-completion-after-resume",
    "verification_commands": [["cargo", "test", "--workspace", "--all-features"]],
    "required_evidence": ["interruption", "checkpoint", "resume", "rollback", "passing-verification"]
  }
}
