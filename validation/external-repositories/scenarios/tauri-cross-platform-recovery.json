    "commit": "adbc8813901bba65827259daa8e22ff94ec1f30e",
    "ecosystem": "rust-cargo"
  },
  "task": "Investigate a bounded cross-platform build failure, survive interruption, restore authoritative state, and complete the relevant verification.",
  "expected_invariants": [
