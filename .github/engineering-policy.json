{
  "schema_version": 1,
  "policy_id": "medusa-engineering-policy-v1",
  "protected_policy_paths": [
    ".github/engineering-policy.json",
    "scripts/engineering-policy.py",
    ".github/workflows/architecture-policy.yml"
  ],
  "rules": [
    {
      "id": "docs-only",
      "description": "Documentation-only changes do not trigger unrelated platform certification.",
      "include": ["docs/**", "README.md", "CONTRIBUTING.md", "SECURITY.md"],
      "exclude": ["docs/architecture/**"],
      "required_checks": ["documentation"],
      "protected": false
    },
    {
      "id": "architecture-boundary",
      "description": "Architecture authority and dependency-boundary changes require architecture conformance.",
      "include": [
        ".github/architecture-policy.json",
        "scripts/architecture-policy.py",
        "scripts/architecture-conformance.py",
        "scripts/check-architecture-index.py",
        "docs/architecture/**",
        "Cargo.toml",
        "crates/*/Cargo.toml"
      ],
      "required_checks": ["architecture-policy", "architecture-conformance"],
      "protected": true
    },
    {
      "id": "containment",
      "description": "Containment or process-launch changes require cross-platform security certification.",
      "include": [
        "crates/medusa-process-containment/**",
        "crates/medusa-agent/src/policy.rs",
        "crates/medusa-agent/src/windows_sandbox.rs",
        "scripts/check-unsafe-policy.py",
        ".github/workflows/*windows*",
        ".github/workflows/*containment*"
      ],
      "required_checks": ["containment-linux", "containment-macos", "containment-windows", "unsafe-policy"],
      "protected": true
    },
    {
      "id": "provider-history",
      "description": "Provider wire/history changes require provider continuity and privacy regressions.",
      "include": [
        "crates/medusa-provider/**",
        "crates/medusa-agent/src/engine/effective_request.rs",
        "crates/medusa-agent/src/engine/**provider**"
      ],
      "required_checks": ["provider-adapter", "provider-history", "privacy"],
      "protected": true
    },
    {
      "id": "durable-state",
      "description": "Durable state and journal changes require replay, migration, and recovery validation.",
      "include": [
        "crates/**/journal*.rs",
        "crates/**/state*.rs",
        "crates/**/migration*.rs",
        "crates/**/recovery*.rs",
        "crates/**/schema*.rs"
      ],
      "required_checks": ["journal-replay", "migration", "recovery"],
      "protected": true
    },
    {
      "id": "certified-tool-pipeline",
      "description": "Tool execution lifecycle changes require certified authority regressions.",
      "include": [
        "crates/medusa-agent/src/**tool**",
        "scripts/check-certified-tool-pipeline.py",
        "docs/TOOL-EXECUTION-PIPELINE.md"
      ],
      "required_checks": ["certified-tool-pipeline", "architecture-policy"],
      "protected": true
    },
    {
      "id": "performance-context",
      "description": "Performance, context, cache, and model-experience changes require benchmark evidence.",
      "include": [
        "benchmarks/**",
        "crates/**/context*.rs",
        "crates/**/cache*.rs",
        "crates/**/compaction*.rs"
      ],
      "required_checks": ["benchmark", "performance-regression"],
      "protected": false
    },
    {
      "id": "self-improvement",
      "description": "Evaluator and self-improvement changes require protected engineering review lanes.",
      "include": [
        "crates/**/learning*.rs",
        "crates/**/improvement*.rs",
        "crates/**/evaluator*.rs"
      ],
      "required_checks": ["protected-improvement", "independent-verification"],
      "protected": true
    },
    {
      "id": "engineering-policy",
      "description": "Changes to engineering policy or its evaluator are protected and cannot self-authorize under the modified policy.",
      "include": [
        ".github/engineering-policy.json",
        "scripts/engineering-policy.py",
        ".github/workflows/architecture-policy.yml"
      ],
      "required_checks": ["engineering-policy-base", "architecture-policy"],
      "protected": true,
      "evaluate_against_base": true
    }
  ]
}
