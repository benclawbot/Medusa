+#[test]
+fn ctrl_e_toggles_activity_details_and_new_session_resets_it() {
+    let repository = tempdir().expect("temporary repository");
+    let mut app = AppState::new(
+        repository.path().to_path_buf(),
+        "session_ctrl_e",
+        "",
+        Arc::new(FakeClipboard(ClipboardContent::Empty)),
+    )
+    .expect("create app");
+
+    assert!(!app.activity_details_expanded);
+    let action = app
+        .handle_event(Event::Key(KeyEvent::new(
+            KeyCode::Char('e'),
+            KeyModifiers::CONTROL,
+        )))
+        .expect("handle Ctrl+E");
+    assert_eq!(action, AppAction::Redraw);
+    assert!(app.activity_details_expanded);
+
+    app.clear_for_new_session();
+    assert!(!app.activity_details_expanded);
+}
