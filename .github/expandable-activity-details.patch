+#[test]
+fn activity_details_are_compact_by_default_and_expand_without_data_loss() {
+    let activity = TranscriptActivity {
+        id: Some("tool-verbose".to_owned()),
+        kind: TranscriptActivityKind::Verification,
+        title: "Run tests".to_owned(),
+        details: (1..=10).map(|line| format!("line {line}")).collect(),
+    };
+
+    let compact = activity_lines(&activity, false);
+    assert_eq!(compact.len(), 7);
+    assert_eq!(compact[5].text, "  └ line 5");
+    assert_eq!(compact[6].text, "  └ … 5 more lines");
+
+    let expanded = activity_lines(&activity, true);
+    assert_eq!(expanded.len(), 11);
+    assert_eq!(expanded[10].text, "  └ line 10");
+    assert_eq!(activity.details.len(), 10);
+}
